# Twist Arcade — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored and is NEVER shared
# between agent worktrees (CLAUDE.md §5) — each team points at its own Supabase stack.
#
#   cp .env.example .env.local
#
# Nothing here is required to run solo or hotseat play. Phase 0 and Phase 1 games are
# static assets plus client JS: no database, no auth, no server. Every variable below is
# either Phase 2+ or optional. If a value is missing, the app must degrade rather than
# crash — a missing analytics key loses a metric, it does not lose a game.


# ─── Site ────────────────────────────────────────────────────────────────────────
# Used for absolute URLs in share artifacts and OG tags. The share artifact is the
# growth engine (target ≥8% of completed dailies), and a share with a broken link is
# worse than no share — so this must be right in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ─── Supabase (Phase 2+: async link multiplayer, leaderboards) ────────────────────
# NOT needed for Phase 0/1. A team whose feature never touches Postgres records
# "Supabase: not started" in docs/worktrees.md rather than booting an unused stack.
#
# LOCAL (the default, and what every agent team uses — CLAUDE.md §5):
# values come from `supabase status` inside YOUR worktree, after setting a unique
# project_id and port block in supabase/config.toml. Never point at another team's
# stack, and never reuse a port block marked ACTIVE.
#
# Port blocks: team n = Supabase defaults + n*100. Team 1 API = 54421, team 2 = 54521, …
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REMOTE (deployed environments only — never in a worktree's .env.local):
#   NEXT_PUBLIC_SUPABASE_URL=https://fjiwrzaosluymamannaw.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<the sb_publishable_… key>
#
# Prefer the modern `sb_publishable_…` key over the legacy JWT `anon` key: it rotates
# independently, and the legacy one is the string every LLM has memorised. Both are
# publishable — neither is a secret — but the publishable key is the one to ship.
#
# The remote schema exists (matches / match_players / moves) with RLS enabled and
# ZERO policies, which denies all client access. Verified, not assumed: a row with a
# canary seed was inserted server-side and the anon client saw [] on every query,
# including one selecting `seed` directly. Phase 2 opens exactly the access it needs.

# Server-only. Bypasses RLS — the route handler uses it to write match state that no
# client may write. Must never be prefixed NEXT_PUBLIC_ (that would ship it to the
# browser) and must never appear in client code.
SUPABASE_SERVICE_ROLE_KEY=


# ─── Analytics (Umami Cloud) ─────────────────────────────────────────────────────
# Share rate is metric #1 for this product; a metric nobody can compute is not a metric.
# Chosen over Vercel Analytics (custom events are paid), Cloudflare (no custom events),
# and GoatCounter (free tier is non-commercial, and ads land in month 2).
#
# Umami is self-hostable on Postgres, so this moves onto our own Supabase in Phase 2
# without changing a single call site — provided everything goes through the one
# track() wrapper and no component imports an analytics SDK directly.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js


# ─── Ads (month 2+, end screen and between games only) ───────────────────────────
# Never inside the play loop. An interstitial between a move and its result would
# break the 8-second arrival and the rematch loop that retention depends on.
# Leave blank until month 2; blank means no ad markup renders at all.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=


# ─── Local development ───────────────────────────────────────────────────────────
# Pin the daily to a specific UTC date to test a known board without waiting a day.
# Ignored in production builds. Format: YYYY-MM-DD.
NEXT_PUBLIC_DAILY_DATE_OVERRIDE=

# Daily #1 is 2026-09-01 UTC. Frozen as a wire-format constant with a golden vector:
# changing it renumbers every artifact ever shared. Listed here for reference only —
# it is NOT read from the environment, precisely so it cannot drift per deployment.
# DAILY_EPOCH=2026-09-01
